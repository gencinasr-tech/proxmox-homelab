# Proxmox Homelab - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Proxmox Host
PROXMOX_IP=192.168.1.200
PROXMOX_HOSTNAME=proxmox

# Network Ranges
LAN_NETWORK=192.168.1.0/24
PRIVATE_NETWORK=10.10.10.0/24
TAILSCALE_NETWORK=100.64.0.0/10

# Gateway
GATEWAY_IP=192.168.1.1

# DNS Servers
PRIMARY_DNS=192.168.1.53
SECONDARY_DNS=1.1.1.1

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================

# Local Domain (for internal services)
LOCAL_DOMAIN=home.arpa

# Tailscale Domain (replace XXXXXX with your actual Tailscale domain)
TAILSCALE_DOMAIN=tailXXXXXX.ts.net

# =============================================================================
# TIMEZONE
# =============================================================================

TZ=Europe/Madrid

# =============================================================================
# CT101 - DASHBOARDS (192.168.1.79)
# =============================================================================

DASHBOARD_IP=192.168.1.79
HOMEPAGE_PORT=3000
HOMARR_PORT=7575
HOMER_PORT=8080
HEIMDALL_PORT=8081

# =============================================================================
# CT102 - PORTAINER (192.168.1.80)
# =============================================================================

PORTAINER_IP=192.168.1.80
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# =============================================================================
# CT103 - DNS (192.168.1.53)
# =============================================================================

DNS_IP=192.168.1.53
ADGUARD_PORT=80

# =============================================================================
# VM104 - CASAOS/NAS (192.168.1.81)
# =============================================================================

CASAOS_IP=192.168.1.81
CASAOS_PORT=80
SYNCTHING_PORT=8384
DUPLICATI_PORT=8200

# =============================================================================
# CT112 - NGINX PROXY MANAGER (192.168.1.82)
# =============================================================================

PROXY_IP=192.168.1.82
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_ADMIN_PORT=81

# =============================================================================
# CT105 - MONITORING (10.10.10.50)
# =============================================================================

MONITORING_IP=10.10.10.50
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
UPTIME_KUMA_PORT=3001
BESZEL_PORT=8090
SPEEDTEST_PORT=8085
SCRUTINY_PORT=8086

# =============================================================================
# CT106 - VAULTWARDEN (10.10.10.60)
# =============================================================================

VAULTWARDEN_DOMAIN=https://vaultwarden.${TAILSCALE_DOMAIN}
VAULTWARDEN_ADMIN_TOKEN=your_secure_admin_token_here
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

# SSO Configuration (if using Keycloak)
VAULTWARDEN_SSO_ENABLED=false
VAULTWARDEN_SSO_ONLY=false
VAULTWARDEN_SSO_AUTHORITY=https://auth.${LOCAL_DOMAIN}/realms/homelab
VAULTWARDEN_SSO_CLIENT_ID=vaultwarden
VAULTWARDEN_SSO_CLIENT_SECRET=your_keycloak_client_secret

# =============================================================================
# NEXTCLOUD (CT108 - 10.10.10.65)
# =============================================================================

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_secure_password_here
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.${LOCAL_DOMAIN} nextcloud.${TAILSCALE_DOMAIN}

# Database Configuration
NEXTCLOUD_DB_TYPE=pgsql
NEXTCLOUD_DB_HOST=10.10.10.73
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=your_db_password_here

# =============================================================================
# IMMICH (VM109 - 10.10.10.30)
# =============================================================================

IMMICH_DB_PASSWORD=your_immich_db_password
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich

# Upload Location
IMMICH_UPLOAD_LOCATION=/mnt/photos

# =============================================================================
# PAPERLESS-NGX (CT107 - 10.10.10.40)
# =============================================================================

PAPERLESS_SECRET_KEY=your_secret_key_here
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=your_admin_password
PAPERLESS_ADMIN_MAIL=admin@${LOCAL_DOMAIN}

# Database
PAPERLESS_DBHOST=10.10.10.73
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=your_db_password

# OCR Language
PAPERLESS_OCR_LANGUAGE=spa+eng

# =============================================================================
# KEYCLOAK (CT113 - 10.10.10.74)
# =============================================================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# Database
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://10.10.10.73:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=your_keycloak_db_password

# Hostname
KC_HOSTNAME=auth.${LOCAL_DOMAIN}
KC_HOSTNAME_STRICT=false

# =============================================================================
# CT110 - TOOLS (10.10.10.70)
# =============================================================================

TOOLS_IP=10.10.10.70
IT_TOOLS_PORT=8080
STIRLING_PDF_PORT=8081

# =============================================================================
# CT111 - DATABASES (10.10.10.73)
# =============================================================================

DATABASES_IP=10.10.10.73

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your_postgres_root_password
POSTGRES_USER=postgres

# MariaDB
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Adminer
ADMINER_PORT=8080

# pgAdmin
PGADMIN_PORT=8082

# ChartDB
CHARTDB_PORT=8083

# =============================================================================
# CT114 - NAVIDROME (10.10.10.82)
# =============================================================================

NAVIDROME_IP=10.10.10.82
NAVIDROME_PORT=4533

# =============================================================================
# CT115 - DOWNLOADS (10.10.10.83)
# =============================================================================

DOWNLOADS_IP=10.10.10.83
MUSIC_DOWNLOADER_PORT=6595

# =============================================================================
# GRAFANA (CT105 - 10.10.10.50)
# =============================================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password
GF_SERVER_ROOT_URL=https://grafana.${LOCAL_DOMAIN}

# SSO with Keycloak (optional)
GF_AUTH_GENERIC_OAUTH_ENABLED=false
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=your_client_secret
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.${LOCAL_DOMAIN}/realms/homelab/protocol/openid-connect/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.${LOCAL_DOMAIN}/realms/homelab/protocol/openid-connect/token

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Duplicati
DUPLICATI_PASSPHRASE=your_encryption_passphrase

# Google Drive (for remote backups)
GDRIVE_CLIENT_ID=your_google_drive_client_id
GDRIVE_CLIENT_SECRET=your_google_drive_client_secret

# Backup Retention
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_WEEKS=12
BACKUP_RETENTION_MONTHS=12

# =============================================================================
# TAILSCALE
# =============================================================================

TAILSCALE_AUTHKEY=tskey-auth-XXXXXXXXXX
TAILSCALE_HOSTNAME=homelab-gateway

# =============================================================================
# SMTP CONFIGURATION (for email notifications)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=homelab@${LOCAL_DOMAIN}

# =============================================================================
# MONITORING
# =============================================================================

# Prometheus
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB

# Alert Manager
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERTMANAGER_EMAIL=alerts@${LOCAL_DOMAIN}

# =============================================================================
# SECURITY
# =============================================================================

# Fail2ban
FAIL2BAN_BANTIME=3600
FAIL2BAN_MAXRETRY=5

# Firewall
FIREWALL_ENABLED=true
FIREWALL_LOG_LEVEL=info

# =============================================================================
# NOTES
# =============================================================================

# 1. Generate secure passwords using: openssl rand -base64 32
# 2. For Vaultwarden admin token: openssl rand -base64 48
# 3. For Paperless secret key: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Never commit .env files to version control
# 5. Keep backups of your .env file in a secure location
# 6. Rotate passwords regularly
# 7. Use different passwords for each service